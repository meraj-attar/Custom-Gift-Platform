# ==============================================================================
# CustomGift Platform — Production Environment Configuration Template
# ==============================================================================
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://customgift:customgift@db:5432/customgift
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Seeded administrator
ADMIN_NAME=CustomGift Admin
ADMIN_EMAIL=admin@customgift.dev
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD

# Razorpay: keep PAYMENT_DEMO_MODE=true until real keys are configured
PAYMENT_DEMO_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (Optional): Local uploads used when blank
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email Delivery (Required for password recovery & contact notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CustomGift
SMTP_USE_TLS=true
