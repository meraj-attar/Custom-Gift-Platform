APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://customgift:customgift@db:5432/customgift
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Seeded administrator (change before deploying)
ADMIN_NAME=CustomGift Admin
ADMIN_EMAIL=admin@customgift.dev
ADMIN_PASSWORD=Admin@123

# Razorpay: keep PAYMENT_DEMO_MODE=true until real keys are configured
PAYMENT_DEMO_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Cloudinary. Local uploads are used when these are blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP password reset delivery. In development, reset link is returned by API.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
